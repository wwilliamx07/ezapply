{
  "manifest_version": 3,
  "name": "ezapply",
  "version": "0.0.0",
  "description": "Set the active job posting for ezapply and let Claude Code fill applications.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "ezapply: Set posting"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Set posting"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms"],
  "host_permissions": ["*://*.myworkdayjobs.com/*", "*://*.myworkdaysite.com/*"]
}
