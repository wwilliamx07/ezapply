{
  "manifest_version": 3,
  "name": "ezapply",
  "version": "0.0.0",
  "description": "ezapply in your browser: set the job posting, tailor documents and fill applications from a side panel.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "ezapply"
  },
  "commands": {
    "set-posting": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Set posting (capture this page)"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms", "webNavigation", "sidePanel", "debugger"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  },
  "host_permissions": ["<all_urls>"],
  "side_panel": {
    "default_path": "panel.html"
  }
}
