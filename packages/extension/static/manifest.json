{
  "manifest_version": 3,
  "name": "ezapply",
  "version": "0.0.0",
  "description": "ezapply in your browser: set the job posting, tailor documents and fill applications from a side panel.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ezapply",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "set-posting": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Set posting (capture this page)"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "webNavigation",
    "sidePanel",
    "debugger",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  },
  "host_permissions": ["<all_urls>"],
  "side_panel": {
    "default_path": "panel.html"
  }
}
